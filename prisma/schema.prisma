generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Spring {
  id              Int          @id @default(autoincrement())
  name            String
  lat             Float
  lon             Float
  elevation       Int
  lithology       String // quartzite | limestone | schist | phyllite | shale
  dipDeg          Float
  dipAzimuth      Float // bearing the strata dip toward
  aspect          Float // bearing the surface slopes toward
  fractureDensity Float // 0-1
  lineamentDistM  Float
  dischargeLps    Float
  declinePct      Float // multi-year discharge decline
  evidenceCount   Int   // independent field/lab evidence items
  slopeDeg        Float
  landslideRisk   Float // 0-1
  tenure          String // community | forest | disputed
  observations    Observation[]
}

model Observation {
  id           Int       @id @default(autoincrement())
  clientId     String    @unique // generated on device; makes sync idempotent
  springId     Int
  spring       Spring    @relation(fields: [springId], references: [id])
  kind         String    // dye_trace | isotope | ec_temp | discharge | lineament
  value        String
  note         String    @default("")
  photo        String?   // compressed JPEG data URL
  lat          Float?
  lon          Float?
  observedAt   DateTime
  status       String    @default("pending") // pending | accepted | rejected
  reviewerNote String    @default("")
  reviewedAt   DateTime?
  reviewedBy   String?   // named reviewer, set server-side from the signed session
}
